class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class LinkedList:
    def __init__(self):
        self.head=None
        self.temp=None
        self.prev=None
    def insertion(self,num):
        newNode=Node(num)
        if self.head is None:
            self.head=newNode
            self.temp=newNode
        else:
            self.temp.next=newNode
            self.temp=newNode
    def display(self):
        temp=self.head
        while temp.next!=None:
            print(temp.data,end="->")
            temp=temp.next
            print(temp.data)
    def insertion_at_start(self,a):
        newNode=Node(a)
        newNode.next=self.head
        self.head=newNode
    def insertion_at_starting(self,b):
        newNode=Node(b)
        temp=self.head
        while temp.next!=None:
            temp=temp.next
            temp.next=newNode
            temp=newNode
