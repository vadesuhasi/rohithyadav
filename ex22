class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class linkedlist:
    def __init__(self):
        self.head=None
        self.temp=None
    def insertion(self,num):
        newNode=Node(num)
        if self.head is None:
            self.head=newNode
            self.temp=newNode
        else:
            self.temp.next=newNode
            self.temp=newNode
    def display(self):
        temp=self.head
        while(temp.next!=None):
            print(temp.data,end="->")
            temp=temp.next
            print(temp.data)
sll=linkedlist()
size=int(input("enter size="))
for i in range(size):
    num=int(input("enter number="))
    sll.insertion(num)
    sll.display
